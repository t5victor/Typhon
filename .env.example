# Copy this file to .env before running Docker Compose.  These are local-lab
# credentials only; generate different values for every non-local environment.
THYPHON_API_KEYS={"local-supplier":{"actor_id":"nordic-mining","role":"supplier"},"local-bidder-nova":{"actor_id":"nova-corp","role":"bidder"},"local-operator":{"actor_id":"thyphon-operator","role":"operator"},"local-payment-provider":{"actor_id":"payment-simulator","role":"payment-provider"}}
THYPHON_PROVIDER_WEBHOOK_SECRET=replace-this-local-webhook-secret
